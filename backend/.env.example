# Environment Configuration Template
# Copy to .env and fill in your values

# Server Configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=nexus_super_secret_key_change_in_production

# Database
MONGODB_URI=mongodb://localhost:27017/nexus_game
MONGODB_USER=admin
MONGODB_PASSWORD=password

# Redis (for caching and real-time data)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# AWS (if using AWS services)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# Game Configuration
MAX_PLAYERS_PER_MATCH=1
MATCH_TIMEOUT=600000
WAVE_DURATION=120000
DIFFICULTY_SCALING=1.15

# API Keys
STRIPE_API_KEY=sk_test_your_stripe_key
TWILIO_AUTH_TOKEN=your_twilio_token

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/server.log

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password

# Push Notifications
FIREBASE_PROJECT_ID=your_firebase_project
FIREBASE_PRIVATE_KEY=your_firebase_key
FIREBASE_CLIENT_EMAIL=your_firebase_email

# Analytics
ANALYTICS_KEY=your_analytics_key

# Sentry (Error tracking)
SENTRY_DSN=your_sentry_dsn

# Feature Flags
ENABLE_RAID_MODE=false
ENABLE_PVP=false
ENABLE_ANALYTICS=true
MAINTENANCE_MODE=false